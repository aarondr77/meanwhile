NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The only two addresses that can sign in, comma separated.
ALLOWED_EMAILS=aaron@example.com,cat@example.com
# Used as the magic-link redirect origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Draws each day's mark when the day is first published; unset means days keep no mark.
# A service user key (cog_ prefix) plus the org it belongs to.
DEVIN_API_KEY=
DEVIN_ORG_ID=org-
# Staging only — enables one-click sign-in as each allowlisted address (no email).
# Leave both unset in production.
SUPABASE_SERVICE_ROLE_KEY=
DEV_LOGIN=
