NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The only two addresses that can sign in, comma separated.
ALLOWED_EMAILS=aaron@example.com,cat@example.com
# The origin notification links point at.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Required everywhere: signing in mints the session server-side.
SUPABASE_SERVICE_ROLE_KEY=
# Draws each day's mark when the day is first published; unset means days keep no mark.
# A service user key (cog_ prefix) plus the org it belongs to.
DEVIN_API_KEY=
DEVIN_ORG_ID=org-
# Staging only — the guard that lets the seed script wipe the database.
DEV_LOGIN=
